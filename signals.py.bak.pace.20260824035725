def get_ohlcv(pool_address: str, limit: int = 30) -> list[dict]:
    """Get hourly OHLCV for a pool."""
    data = gecko_get(f"pools/{pool_address}/ohlcv/hour?aggregate=1&limit={limit}")
    candles = []
    for row in data.get("data", {}).get("attributes", {}).get("ohlcv_list", []):
        # Gecko returns [timestamp, open, high, low, close, volume]
        if len(row) >= 6:
            candles.append({
                "ts": row[0],
                "o": float(row[1] or 0),
                "h": float(row[2] or 0),
                "l": float(row[3] or 0),
                "c": float(row[4] or 0),
                "v": float(row[5] or 0),
            })
    return candles


def compute_roc(candles: list[dict], lookback: int) -> float:
    """Rate of change: (close_now / close_lookback) - 1."""
    if len(candles) < lookback + 1:
        return 0.0
    now = candles[-1]["c"]
    past = candles[-lookback]["c"]
    if past == 0:
        return 0.0
    return (now - past) / past


def score_opportunity(pool: dict) -> float:
    """
    Score a pool 0-100 based on:
    - 5m momentum
    - 1h momentum
    - Volume vs liquidity
    - Liquidity depth
    """
    score = 0.0
    
    # 5m momentum: up to 30 points
    chg5 = pool.get("price_change_5m", 0) or 0
    score += min(max(chg5 * 600, 0), 30)  # 5% = 30pts
    
    # 1h momentum: up to 25 points
    chg1h = pool.get("price_change_1h", 0) or 0
    score += min(max(chg1h * 200, 0), 25)  # 5% = 25pts
    
    # Volume/liquidity ratio: up to 25 points
    liq = pool.get("liquidity_usd", 0) or 0
    vol = pool.get("volume_24h_usd", 0) or 0
    if liq > 0:
        ratio = vol / liq
        score += min(ratio * 500, 25)  # ratio=0.05 = 25pts
    
    # Liquidity depth: up to 20 points
    if liq >= MIN_LIQUIDITY_USD:
        score += 20
    elif liq >= 500_000:
        score += 10
    
    # Volume floor: 10 points
    if vol >= MIN_24H_VOLUME_USD:
        score += 10
    
    # Penalty: stable pairs
    name = (pool.get("name", "") or "").lower()
    if any(s in name for s in ["usdc", "usdt", "dai", "weth"]):
        if "weth" in name and "usdc" in name:
            score -= 50
    
    return min(max(score, 0), 100)


def scan_opportunities(
    macro_regime: str = "neutral",
    min_score: float = 50.0,
) -> list[dict]:
    """
    Main entry: scan for opportunities given macro regime.
    Returns scored, filtered pool list.
    
    Now integrates aeon bridge signals (narrative-tracker) for regime + token bias.
    """
    # --- Bridge integration: pull narrative signals ---
    bridge = get_bridge_signals() if BRIDGE_AVAILABLE else {"available": False}
    
    # Use bridge macro_regime if available and caller didn't override
    if bridge.get("available") and macro_regime == "neutral":
        bridge_regime = bridge.get("macro_regime", "neutral")
        # Map bridge regimes to our regimes
        regime_map = {"risk_on": "aggressive_hunting", "risk_off": "risk_off", "neutral": "neutral"}
        macro_regime = regime_map.get(bridge_regime, "neutral")
        print(f"[BRIDGE] Using narrative-tracker regime: {bridge_regime} -> {macro_regime}")
    
    tokens_to_watch = set(bridge.get("tokens_to_watch", []))
    positioning = bridge.get("positioning", {})
    
    opportunities = []
    
    # Layer 2a: Gas spike detection
    gas_spike, current_gas, median_gas = detect_gas_spike()
    
    # Layer 2b: Trending + new pools
    trending = get_trending_pools(limit=20)
    new_pools = get_new_pools(limit=20)
    all_pools = trending + new_pools
    
    # De-duplicate by pool_address
    seen = set()
    unique_pools = []
    for p in all_pools:
        addr = p.get("pool_address", "")
        if addr and addr not in seen:
            seen.add(addr)
            unique_pools.append(p)
    
    # Score and filter
    for pool in unique_pools:
        # Hard filters
        liq = pool.get("liquidity_usd", 0) or 0
        vol = pool.get("volume_24h_usd", 0) or 0
        
        if liq < MIN_LIQUIDITY_USD:
            continue
        if vol < MIN_24H_VOLUME_USD:
            continue
        
        # Skip stable pairs
        name = (pool.get("name", "") or "").lower()
        if any(s in name for s in ["usdc/usdt", "usdt/usdc", "dai/usdc"]):
            continue
        
        # Score
        score = score_opportunity(pool)
        
        # --- Bridge boost: tokens_to_watch get +15 score ---
        token_sym = (pool.get("token_symbol", "") or "").upper()
        if token_sym in tokens_to_watch:
            score += 15
            pool["bridge_boost"] = "tokens_to_watch"
        
        # --- Bridge boost: positioning calls ---
        # Check if any narrative in positioning matches this token
        for narrative, pos in positioning.items():
            if narrative.lower() in name.lower() or narrative.lower() in token_sym.lower():
                call = pos.get("call", "")
                if call == "LONG":
                    score += 10
                    pool["bridge_boost"] = pool.get("bridge_boost", "") + " positioning_long"
                elif call == "SHORT":
                    score -= 20  # Penalty for SHORT narratives
                    pool["bridge_boost"] = pool.get("bridge_boost", "") + " positioning_short"
        
        # Regime-aware threshold
        threshold = min_score
        if macro_regime == "aggressive_hunting":
            threshold = min_score * 0.8  # lower bar
        elif macro_regime == "risk_off":
            threshold = min_score * 1.5  # higher bar
        
        if score >= threshold:
            pool["score"] = score
            pool["gas_spike"] = gas_spike
            pool["gas_current_gwei"] = current_gas
            pool["gas_median_gwei"] = median_gas
            pool["macro_regime"] = macro_regime
            opportunities.append(pool)
    
    # Sort by score desc
    opportunities.sort(key=lambda x: x["score"], reverse=True)
    return opportunities[:10]


