# Thresholds
GAS_SPIKE_GWEI = 15          # gwei above recent median = spike
VOLUME_SPIKE_MULT = 3.0      # 24h volume > 3x 7d avg = spike
MIN_LIQUIDITY_USD = 500_000
MIN_24H_VOLUME_USD = 1_000_000
ROC_LOOKBACK = 8              # bars for rate-of-change


def rpc_call(method: str, params: list = None) -> dict:
    """Call Base JSON-RPC with stdlib."""
    if params is None:
        params = []
    payload = json.dumps({
        "jsonrpc": "2.0",
        "method": method,
        "params": params,
        "id": 1,
    }).encode()
    req = urllib.request.Request(
        BASE_RPC,
        data=payload,
        headers={"Content-Type": "application/json", "User-Agent": "Mozilla/5.0"},
    )
    with urllib.request.urlopen(req, timeout=20) as r:
        return json.loads(r.read())


def get_gas_price_gwei() -> int:
    """Return current Base gas price in gwei."""
    resp = rpc_call("eth_gasPrice")
    wei = int(resp.get("result", "0x0"), 16)
    return wei // 10**9


def get_recent_gas_blocks(num_blocks: int = 20) -> list[int]:
    """Fetch recent block gas prices from Base."""
    latest = rpc_call("eth_blockNumber")
    latest_num = int(latest.get("result", "0x0"), 16)
    
    gas_prices = []
    for i in range(num_blocks):
        block_num = latest_num - i
        hex_block = hex(block_num)
        block_resp = rpc_call("eth_getBlockByNumber", [hex_block, False])
        block = block_resp.get("result", {})
        gas_price = block.get("gasPrice", "0x0")
        if gas_price != "0x0":
            gas_prices.append(int(gas_price, 16) // 10**9)
    
    return gas_prices


def detect_gas_spike() -> tuple[bool, int, int]:
    """
    Detect if current gas is spiking vs recent median.
    Uses CDP SQL API if available, falls back to Base RPC.
    Returns (is_spike, current_gwei, median_gwei)
    """
    # Try CDP SQL API first (more reliable, cached)
    try:
        from cdp_sql import get_base_gas_trends, is_configured as cdp_configured
        if cdp_configured():
            result = get_base_gas_trends(limit=20)
            if result.get("configured") and result.get("results"):
                rows = result["results"]
                gas_prices = []
                for row in rows:
                    base_fee = row.get("base_fee_per_gas")
                    if base_fee is not None:
                        gas_prices.append(int(base_fee) // 10**9)
                if gas_prices:
                    current = gas_prices[0]  # most recent
                    recent_sorted = sorted(gas_prices)
                    median = recent_sorted[len(recent_sorted) // 2]
                    is_spike = current >= median + GAS_SPIKE_GWEI
                    return is_spike, current, median
    except Exception:
        pass
    
    # Fallback to Base RPC
    try:
        current = get_gas_price_gwei()
        recent = get_recent_gas_blocks(20)
        if not recent:
            return False, current, current
        recent_sorted = sorted(recent)
        median = recent_sorted[len(recent_sorted) // 2]
        is_spike = current >= median + GAS_SPIKE_GWEI
        return is_spike, current, median
    except Exception as e:
        print(f"Gas detection error: {e}")
        return False, 0, 0


def gecko_get(path: str) -> dict:
    """GET from GeckoTerminal with error handling."""
    url = f"{GECKO_BASE}/{path.lstrip('/')}"
    req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            return json.loads(r.read())
    except Exception as e:
        print(f"GeckoTerminal fetch error ({path}): {e}")
        return {}


def get_trending_pools(limit: int = 20) -> list[dict]:
    """Get trending pools on Base from GeckoTerminal."""
    data = gecko_get("trending_pools")
    pools = []
    for item in data.get("data", []):
        attrs = item.get("attributes", {})
        rel = item.get("relationships", {})
        base_id = rel.get("base_token", {}).get("data", {}).get("id", "")
        quote_id = rel.get("quote_token", {}).get("data", {}).get("id", "")
        # Convert "base_0x..." / "quote_0x..." to plain address
        base_addr = "0x" + base_id.split("_")[-1][2:] if base_id.startswith("base_0x") else ""
        quote_addr = "0x" + quote_id.split("_")[-1][2:] if quote_id.startswith("quote_0x") else ""
        weth = "0x4200000000000000000000000000000000000006"
        # Token is the non-WETH side of the pool
        token_addr = base_addr if base_addr.lower() != weth.lower() else quote_addr
        pools.append({
            "pool_address": attrs.get("address", ""),
            "token_address": token_addr,
            "token_symbol": attrs.get("name", "").split("/")[0].strip(),
            "name": attrs.get("name", ""),
            "price_usd": float(attrs.get("base_token_price_usd", 0) or 0),
            "liquidity_usd": float(attrs.get("reserve_in_usd", 0) or 0),
            "volume_24h_usd": float((attrs.get("volume_usd", {}) or {}).get("h24", 0) or 0),
            "price_change_5m": float((attrs.get("price_change_percentage", {}) or {}).get("m5", 0) or 0),
            "price_change_1h": float((attrs.get("price_change_percentage", {}) or {}).get("h1", 0) or 0),
            "fdv_usd": float(attrs.get("fdv_usd", 0) or 0),
            "pool_created_at": attrs.get("pool_created_at", ""),
        })
    return pools


