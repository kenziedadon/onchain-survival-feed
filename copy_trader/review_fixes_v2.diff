+def _parse_timestamp(ts: Any) -> int:
+    """Safely parse a timestamp string into unix seconds, returning 0 on failure."""
+    if not ts:
+        return 0
+    try:
+        return int(datetime.fromisoformat(str(ts).replace("Z", "+00:00")).timestamp())
+    except (ValueError, TypeError):
+        try:
+            return int(float(ts))
+        except (ValueError, TypeError):
+            return 0
+
