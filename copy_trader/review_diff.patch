+            amount_in=0.1,
+            amount_out=100.0,
+            timestamp=int(time.time()),
+            is_buy=True,
+        )
+
+        # First time — should open
+        pick_id = f"{buy_swap.wallet_address}:{buy_swap.tx_hash}"
+        assert pick_id not in state.seen_tx_hashes, "Tx already seen (shouldn't be)"
+        state.seen_tx_hashes.add(pick_id)
