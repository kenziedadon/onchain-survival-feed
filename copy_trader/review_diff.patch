+def test_detection_proof(config_path: str) -> bool:
+    """Test 2: Detection proof — one real swap per wallet from last 7 days."""
+    print("\n=== TEST 2: Detection proof (real swaps from last 7 days) ===")
+    try:
+        poller = CopyTraderPoller(config_path, "/tmp/test_state.json", "/tmp/test_closes.jsonl")
+        wallets = poller.config.get("wallets", [])
+
+        found_swaps = []
+        for wallet in wallets:
+            address = wallet["address"]
+            label = wallet.get("label", address)
+            print(f"\n  Checking {label} ({address})...")
+
+            try:
+                txs = fetch_wallet_transactions(address)
+            except Exception as e:
+                print(f"    ✗ Failed to fetch txs: {e}")
+                continue
+
+            # Look for DEX swaps in recent txs
+            for tx in txs:
+                tx_hash = tx.get("hash", "")
+                if not tx_hash:
+                    continue
+                if not is_dex_swap(tx):
+                    continue
+
+                # Fetch receipt
+                try:
+                    receipt = fetch_tx_receipt(tx_hash)
+                except Exception as e:
+                    print(f"    ⚠ Failed to fetch receipt for {tx_hash}: {e}")
+                    continue
+
+                if not receipt:
+                    continue
+
+                swap = extract_swap_from_receipt(receipt, address)
+                if swap:
+                    swap.wallet_label = label
+                    found_swaps.append(swap)
+                    print(f"    ✓ Found swap: {tx_hash[:20]}...")
+                    print(f"      {'BUY' if swap.is_buy else 'SELL'}: {swap.amount_in:.4f} {swap.token_in[:10]}... -> {swap.amount_out:.4f} {swap.token_out[:10]}...")
+                    break  # One per wallet is enough
+
+        if len(found_swaps) >= 1:
+            print(f"\n  ✓ Detection proof: {len(found_swaps)} swaps found across wallets")
+            return True
+        else:
+            print(f"\n  ✗ No swaps found in recent txs")
+            return False
+    except Exception as e:
+        print(f"  ✗ FAILED: {e}")
+        import traceback
+        traceback.print_exc()
+        return False
+
