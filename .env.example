# Base Data Layer Configuration
# All values optional — works with zero API keys

# RPC endpoints (override defaults)
# RPC_POOL_URLS=https://mainnet.base.org,https://base-rpc.publicnode.com

# BaseScan API key (optional, increases rate limit)
# BASESCAN_API_KEY=your_key_here

# Default wallet (if not using wallet.json)
# TRADING_WALLET=0xe7a16Be2aF1eCE8922d9d3aD55C03e29004e540F

# Price feed preference: "dexscreener" or "geckoterminal"
# PRICE_FEED=dexscreener
