         )
+
+    # -- tiered intake screening (WO: tiered screening rules) ----------- #
+    #
+    # Fetching lives here, per the WO: "fetching stays in the intake's fetch
+    # layer, testable separately." screening_tiers.screen_token() is a pure
+    # function over the bundle this builds, so the gate logic is unit-tested
+    # without network and this layer is the only thing that touches HTTP.
+    #
+    # Every source is independently optional. A failure to fetch one source
+    # leaves that section of the bundle absent, and screen_token marks the
+    # dependent sub-gate `unknown` rather than failing the run (WO failure
+    # handling: fail-open with logging, fail-closed only on positive bad
+    # signals).
+
+    DEXSCREENER = "https://api.dexscreener.com/latest/dex/tokens/{addr}"
+    GOPLUS = ("https://api.gopluslabs.io/api/v1/token_security/8453"
+              "?contract_addresses={addr}")
+    BLOCKSCOUT = "https://base.blockscout.com/api/v2"
+    # Blockscout's WAF rejects non-browser agents outright (403).
+    _UA = ("Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 "
+           "(KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36")
+
+    def _get_json(self, url: str, timeout: int = 20):
+        """GET a JSON document, returning None on any failure.
+
+        Never raises: a screening source error is an `unknown` sub-gate,
+        not an intake failure.
+        """
+        import json as _json
+        import urllib.request
+        req = urllib.request.Request(url, headers={
+            "User-Agent": self._UA, "Accept": "application/json"})
+        try:
+            with urllib.request.urlopen(req, timeout=timeout) as r:
+                return _json.loads(r.read())
+        except Exception:
+            return None
+
+    def fetch_screening_bundle(self, token: str) -> dict:
+        """Assemble the DexScreener + Blockscout + GoPlus bundle for screening.
+
+        Returns a bundle for ``screening_tiers.screen_token``. Missing
+        sections are simply absent; the screener reports which sub-gates
+        went `unknown`.
+        """
+        token = token.strip().lower()
+        bundle: dict = {}
+
+        # --- DexScreener: mcap, txns h24, pairCreatedAt, socials ---
+        ds = self._get_json(self.DEXSCREENER.format(addr=token))
+        pairs = [p for p in ((ds or {}).get("pairs") or [])
+                 if p.get("chainId") == "base"]
+        if pairs:
+            best = max(pairs, key=lambda p: (p.get("liquidity") or {}).get("usd") or 0)
+            bundle["dexscreener"] = {
+                "pairCreatedAt": best.get("pairCreatedAt"),
+                "liquidity_usd": (best.get("liquidity") or {}).get("usd") or 0,
+                "volume_24h": (best.get("volume") or {}).get("h24") or 0,
+                # marketCap is the correct field; fdv is a fallback and is
+                # NOT the same thing (fdv ignores locked/unminted supply).
+                "mcap": best.get("marketCap") or best.get("fdv") or 0,
+                "txns_24h": (best.get("txns") or {}).get("h24") or {},
+                "info": best.get("info") or {},
+            }
+
+        # --- GoPlus: total_supply (whole tokens) + dex[] pool exclusion ---
+        gp = self._get_json(self.GOPLUS.format(addr=token))
+        rec = ((gp or {}).get("result") or {}).get(token, {})
+        if rec:
+            bundle["goplus"] = {
+                "dex": rec.get("dex") or [],
+                "total_supply": rec.get("total_supply"),
+                "holder_count": rec.get("holder_count"),
+            }
+
+        # --- Blockscout: holders (raw values) + RAW total supply ---
+        holders_doc = self._get_json(
+            f"{self.BLOCKSCOUT}/tokens/{token}/holders")
+        items = (holders_doc or {}).get("items") or []
+        if items:
+            bundle["blockscout"] = {
+                "holders": [
+                    {"address": (i.get("address") or {}).get("hash", ""),
+                     # `value` is RAW base units (18 decimals), not tokens.
+                     "balance": i.get("value") or 0}
+                    for i in items
+                ],
+            }
+        # The raw supply is the only denominator commensurate with raw
+        # holder values (see screening_tiers UNITS NOTE).
+        tok_doc = self._get_json(f"{self.BLOCKSCOUT}/tokens/{token}")
+        if tok_doc:
+            bundle.setdefault("blockscout", {})["total_supply_raw"] = \
+                tok_doc.get("total_supply")
+            bundle["blockscout"]["decimals"] = tok_doc.get("decimals")
+
+        return bundle
